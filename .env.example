# Required - Helius API Configuration
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=your_api_key_here
LASERSTREAM_ENDPOINT=wss://devnet.helius-laserstream.com

# Required - Bot Wallet
BOT_WALLET_PRIVATE_KEY=your_base58_encoded_private_key_here

# Optional - Testing/Demo Scripts Only
SOURCE_WALLET_PRIVATE_KEY=your_source_wallet_base58_private_key

# Required - Wallets to Copy (comma-separated public keys)
WATCH_WALLETS=wallet1_address,wallet2_address

# Trading Parameters
PUMPFUN_BUY_AMOUNT=0.005          # SOL amount per pump.fun buy
PUMPSWAP_BUY_AMOUNT=0.002         # SOL amount per PumpSwap buy
MIN_TRADE_AMOUNT=0.001            # Minimum SOL amount to execute trades
PUMPFUN_SLIPPAGE_BPS=500          # Slippage tolerance for pump.fun (500 = 5%)
PUMPSWAP_SLIPPAGE_BPS=1000        # Slippage tolerance for PumpSwap (1000 = 10%)

# Optional - Advanced Configuration (defaults shown)
MODE=live                         # Bot mode: "live" or "simulate"
RPC_COMMITMENT=processed          # RPC commitment: "processed", "confirmed", or "finalized"
MIN_BALANCE=0.1                   # Minimum SOL balance required
PRIORITY_FEE_UNIT_LIMIT=250000    # Priority fee compute unit limit
PRIORITY_FEE_UNIT_PRICE=250000    # Priority fee compute unit price (micro-lamports)
PUMPFUN_ENABLED=true              # Enable/disable pump.fun protocol
PUMPSWAP_ENABLED=true             # Enable/disable PumpSwap protocol
LOG_FILE=./logs/bot.log           # Log file path
